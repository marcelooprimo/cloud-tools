# Configuração do ansible-lint (executado no CI — .github/workflows/ci.yaml)
#
# var-naming[no-role-prefix]: as variáveis da role (kubectl_version, zsh_install…)
# são a API pública de configuração do playbook desde a 1.0.0; prefixá-las com
# workstation_ quebraria todos os usos existentes. Decisão documentada — skip.
#
# latest[git], package-latest e no-changed-when são ERRO desde a fase 2
# (supply chain); fqcn é ERRO desde a fase 4 (refactor estrutural).

skip_list:
  - var-naming[no-role-prefix]

warn_list:
  - command-instead-of-shell  # Use shell only when shell functionality is required
  - experimental  # all rules tagged as experimental
  - yaml  # Violations reported by yamllint
